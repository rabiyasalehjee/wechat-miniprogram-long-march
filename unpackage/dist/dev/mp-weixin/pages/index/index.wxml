<view class="app"><image class="bg-image" src="{{a}}" mode="aspectFill"/><view class="top-nav"><view class="nav-left"><view class="nav-row-1"><text class="nav-yellow">今日步数：{{b}}</text><text class="nav-yellow nav-gap">今日排名：{{c}}</text></view><view class="nav-row-2"><text class="nav-yellow nav-hint">距离延安还有{{d}}步，继续加油！</text></view></view><button class="sync-btn" bindtap="{{e}}">同步微信步数</button></view><view wx:if="{{f}}" class="tab1-wrapper"><view class="title-section"><image class="title-image" src="{{g}}" mode="widthFix"/><view class="countdown-badge"><text class="countdown-text">距离活动结束还有{{h}}天</text></view></view><view class="tab1-content" id="map-container"><canvas canvas-id="routeCanvas" id="routeCanvas" class="route-canvas"></canvas><view wx:for="{{i}}" wx:for-item="cp" wx:key="b" class="{{['checkpoint', cp.c]}}" style="{{'left:' + cp.d + ';' + ('top:' + cp.e)}}"><text wx:if="{{cp.a}}" class="cp-star">★</text></view></view></view><view wx:if="{{j}}" class="tab2-wrapper"><view wx:if="{{k}}" class="loading-wrap"><text class="placeholder-text">加载中...</text></view><scroll-view wx:else scroll-y class="leaderboard-list"><view wx:for="{{l}}" wx:for-item="item" wx:key="f" class="leader-item"><text class="{{['rank-num', item.b && 'rank-top']}}">{{item.a}}</text><view class="avatar-wrap"><image class="avatar" src="{{item.c}}" mode="aspectFill"/></view><text class="leader-name">{{item.d}}</text><text class="leader-steps">{{item.e}} 步</text></view><view wx:if="{{m}}" class="empty-wrap"><text class="placeholder-text">暂无数据</text></view></scroll-view></view><view class="bottom-nav"><view class="tab-item" bindtap="{{o}}"><text class="tab-text">今日榜单</text><view wx:if="{{n}}" class="active-line"></view></view><view class="tab-divider"></view><view class="tab-item" bindtap="{{q}}"><text class="tab-text">本期榜单</text><view wx:if="{{p}}" class="active-line"></view></view></view><view wx:if="{{r}}" class="modal-mask"><view class="modal-box"><text class="modal-title">设置您的资料</text><text class="modal-hint">用于在排行榜中显示您的信息</text><button class="avatar-picker-btn" open-type="chooseAvatar" bindchooseavatar="{{t}}"><image class="modal-avatar" src="{{s}}" mode="aspectFill"/><text class="avatar-picker-label">点击选择头像</text></button><input class="nickname-input" type="nickname" placeholder="输入您的昵称" value="{{v}}" bindblur="{{w}}" bindinput="{{x}}"/><button class="modal-confirm-btn" bindtap="{{y}}">确认并同步步数</button><button class="modal-cancel-btn" bindtap="{{z}}">取消</button></view></view></view>