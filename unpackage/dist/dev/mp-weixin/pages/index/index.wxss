
page {
  height: 100%;
  overflow: hidden;
}
.app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}
.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.top-nav,
.tab1-wrapper,
.tab2-wrapper,
.bottom-nav {
  position: relative;
  z-index: 1;
}

/* ── Top Nav ── */
.top-nav {
  background-color: #2c7c41;
  padding: 20rpx 32rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.nav-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  margin-right: 24rpx;
}
.nav-row-1 {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}
.nav-row-2 {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.nav-yellow {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}
.nav-gap {
  margin-left: 40rpx;
}
.nav-hint {
  font-size: 24rpx;
  color: #ffffff;
}
.sync-btn {
  background-color: #ffffff;
  color: #76c9ad;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: 2rpx solid #76c9ad;
  padding: 0 28rpx;
  height: 78rpx;
  line-height: 78rpx;
  min-width: 0;
  flex-shrink: 0;
  align-self: center;
}
.sync-btn::after {
  border: none;
}

/* ── Tab 1 ── */
.tab1-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.title-section {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx 8rpx;
}
.title-image {
  width: 85%; /* Reduced to give more space for map */
}
.countdown-badge {
  margin-top: 10rpx;
  background-color: #f6d18a;
  border-radius: 100rpx;
  padding: 6rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.countdown-text {
  font-size: 22rpx; /* Reduced by ~5px equivalent to prevent overlap */
  color: #2d6040;
  font-weight: 600;
}
.tab1-content {
  flex: 1;
  display: flex;
  position: relative;
  width: 100%;
}
.route-canvas {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}
.checkpoint {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  z-index: 2;
  transition: all 0.5s ease;
}
.checkpoint-dot.checkpoint-active {
  width: 14rpx;
  height: 14rpx;
  background-color: #660000; /* Active dark red */
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(102, 0, 0, 0.5);
}
.checkpoint-dot.checkpoint-inactive {
  width: 14rpx;
  height: 14rpx;
  background-color: rgba(255, 255, 255, 0.4); /* Inactive grey */
  border-radius: 50%;
}
.checkpoint-star {
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
}
.checkpoint-star.checkpoint-active .cp-star {
  color: #660000; /* Active dark red */
  text-shadow: 0 0 10rpx rgba(102, 0, 0, 0.6);
}
.checkpoint-star.checkpoint-inactive .cp-star {
  color: rgba(255, 255, 255, 0.5); /* Inactive grey */
}
.cp-star {
  font-size: 40rpx;
  transition: color 0.5s ease;
}
.checkpoint-label-container {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%);
  z-index: 3;
  pointer-events: none; /* Let touches pass through to points if needed */
}
.cp-label {
  position: absolute;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
}

/* Reduced margins to look tighter but still clear arrows/points */
.label-right {
  left: 100%;
  margin-left: 18rpx;
  top: 50%;
  transform: translateY(-50%);
}
.label-left {
  right: 100%;
  margin-right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
}
.label-top {
  bottom: 100%;
  margin-bottom: 18rpx;
  left: 50%;
  transform: translateX(-50%);
}
.label-bottom {
  top: 100%;
  margin-top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
}
.label-bottom-left {
  top: 100%;
  right: 0;
}
.final-text {
  position: absolute;
  left: 100%;
  margin-left: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.6);
}

/* Sonar pulse ring for crossed checkpoint dots */
@keyframes sonarPulse {
0%   { transform: scale(1);   opacity: 0.8;
}
100% { transform: scale(3.5); opacity: 0;
}
}
.pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #660000;
  animation: sonarPulse 1.5s infinite ease-out;
  pointer-events: none;
}
.user-marker {
  position: absolute;
  transform: translate(-50%, -100%);
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.user-marker-img {
  width: 36rpx;
  height: 36rpx;
}
.user-marker-steps {
  position: absolute;
  white-space: nowrap;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.9);
}
.user-steps-top    { bottom: 100%; margin-bottom: 6rpx; left: 50%; transform: translateX(-50%);
}
.user-steps-bottom { top: 100%;    margin-top: 6rpx;    left: 50%; transform: translateX(-50%);
}
.user-steps-left   { right: 100%; margin-right: 8rpx; top: 50%; transform: translateY(-50%);
}
.user-steps-right  { left: 100%;  margin-left: 8rpx;  top: 50%; transform: translateY(-50%);
}

/* ── Tab 2 ── */
.tab2-wrapper {
  flex: 1;
  background-color: #2d6040;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.loading-wrap,
.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.leaderboard-list {
  flex: 1;
  height: 100%;
  padding: 16rpx 0;
}
.leader-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.rank-num {
  width: 48rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}
.rank-top {
  color: #f5d76e;
}
.avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 20rpx;
  flex-shrink: 0;
  background-color: rgba(255,255,255,0.1);
}
.avatar {
  width: 80rpx;
  height: 80rpx;
}
.leader-name {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}
.leader-steps {
  font-size: 28rpx;
  color: #f5d76e;
  font-weight: 700;
  flex-shrink: 0;
}
.placeholder-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ── Bottom Nav ── */
.bottom-nav {
  background-color: #2c7c41;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) / 2);
  flex-shrink: 0;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}
.tab-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 500;
}
.tab-divider {
  width: 2rpx;
  height: 44rpx;
  background-color: rgba(255, 255, 255, 0.3);
}
.active-line {
  position: absolute;
  bottom: 14rpx;
  width: 40rpx;
  height: 6rpx;
  background-color: #ffffff;
  border-radius: 3rpx;
}

/* ── Profile Modal ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d6040;
  margin-bottom: 12rpx;
}
.modal-hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 40rpx;
}
.avatar-picker-btn {
  background: none;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin-bottom: 32rpx;
}
.avatar-picker-btn::after {
  border: none;
}
.modal-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #e0e0e0;
  margin-bottom: 12rpx;
}
.avatar-picker-label {
  font-size: 24rpx;
  color: #2d6040;
}
.nickname-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
.modal-confirm-btn {
  width: 100%;
  height: 88rpx;
  background-color: #2d6040;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  line-height: 88rpx;
  margin-bottom: 16rpx;
}
.modal-confirm-btn::after {
  border: none;
}
.modal-cancel-btn {
  width: 100%;
  height: 80rpx;
  background: none;
  color: #888;
  font-size: 26rpx;
  line-height: 80rpx;
}
.modal-cancel-btn::after {
  border: none;
}
